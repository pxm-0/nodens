---
interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className } = Astro.props;
const text = label.replace(/^./, (character) => character.toUpperCase());
---

<a class={className} href={href}>
  {text} <span aria-hidden="true">↗</span><span class="visually-hidden"> (external link)</span>
</a>
