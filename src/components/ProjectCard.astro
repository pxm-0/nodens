---
import type { CollectionEntry } from 'astro:content';
import { hasRecord, projectHref } from '../lib/content';
import ExternalLink from './ExternalLink.astro';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const record = hasRecord(project);
---

<article class="project-card" id={project.id}>
  <h3>{record ? <a href={projectHref(project)}>{project.data.title}</a> : project.data.title}</h3>
  <div class="project-meta">
    <span>{project.data.stageLabel}</span>
    <span>{project.data.year}</span>
  </div>
  <p>{project.data.summary}</p>
  {project.data.caveat && <p class="caveat">{project.data.caveat}</p>}
  {(record || project.data.links.length > 0) && (
    <div class="page-actions">
      {record && <a class="text-link" href={projectHref(project)}>Open record →</a>}
      {project.data.links.map((link) => (
        <ExternalLink class="text-link" href={link.href} label={link.kind} />
      ))}
    </div>
  )}
</article>
