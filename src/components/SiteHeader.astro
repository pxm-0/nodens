---
interface Props { exhibition?: boolean; practice?: boolean }
const { exhibition = false, practice = false } = Astro.props;
// The exhibition and the landing are both sequences of frames with an index panel.
const frames = exhibition || practice;
const tagline = exhibition ? 'Public edge / 01' : 'Dustin Aceveda';
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`Nodens ${tagline}, home`}>
    <strong>Nodens</strong>
    <small>{tagline}</small>
  </a>
  <nav class="utility-nav" aria-label="Primary">
    <a class:list={{ 'nav-secondary': frames }} href="/engineering/">Work</a>
    <a class="nav-secondary" href="/writing/">Writing</a>
    <a class="nav-secondary" href="/about/">About</a>
    <a href="/contact/">Contact</a>
    {!exhibition && <a href="/exhibition/">Exhibition</a>}
    {frames && (
      <button class="index-toggle" id="indexToggle" aria-expanded="false" aria-controls="exhibitionIndex" aria-haspopup="dialog">
        Index <span>＋</span>
      </button>
    )}
  </nav>
</header>
