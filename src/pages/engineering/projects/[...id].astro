---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ExternalLink from '../../../components/ExternalLink.astro';
import { entryHref, sortEntries } from '../../../lib/content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const relatedEntries = sortEntries(
  await getCollection(
    'entries',
    ({ data }) => !data.draft && data.relatedProjects.some((relatedProject) => relatedProject.id === project.id),
  ),
);
const isMaintenance = project.data.recordState === 'maintenance';
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  robots={isMaintenance ? 'noindex,follow' : 'index,follow'}
>
  <main class="article-shell" id="main">
    <article class="article">
      <header class="article-header">
        <p class="eyebrow">Project record / {project.data.title}</p>
        {isMaintenance ? (
          <>
            <h1>Server migration in progress.</h1>
            <p class="dek">The public Nodens record for {project.data.title} is temporarily unavailable while the site’s project surfaces move to the new server. Its current public stage is {project.data.stageLabel}. Verified destinations remain available below.</p>
          </>
        ) : (
          <>
            <h1>{project.data.title}</h1>
            <p class="dek">{project.data.subtitle}</p>
            {project.data.caveat && <p class="dek caveat">{project.data.caveat}</p>}
          </>
        )}
      </header>
      {isMaintenance ? (
        <div class="page-actions">
          {project.data.links.map((link) => <ExternalLink class="text-link" href={link.href} label={link.kind} />)}
          <a class="text-link" href="/engineering/">Return to engineering →</a>
          <a class="text-link" href="/index/">Open index →</a>
        </div>
      ) : (
        <div class="prose"><Content /></div>
      )}
      {relatedEntries.length > 0 && (
        <aside class="related-links" aria-label="Related entries">
          <p class="eyebrow">Related {relatedEntries.length === 1 ? 'entry' : 'entries'}</p>
          <ul class="formal-list">
            {relatedEntries.map((entry) => <li><a href={entryHref(entry)}>{entry.data.title}</a></li>)}
          </ul>
        </aside>
      )}
      {!isMaintenance && <a class="text-link" href="/engineering/">Return to engineering →</a>}
    </article>
  </main>
  <SiteFooter slot="footer" />
</BaseLayout>
