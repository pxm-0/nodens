---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/exhibition.css';
import '../styles/practice.css';
import { sortProjects } from '../lib/content';
import { contactEmail, conversationHref } from '../lib/site';

const shapes = [
  {
    id: 'automate',
    name: 'Automate',
    gist: 'One workflow',
    line: 'One workflow that costs your team hours, automated, documented, and fixed in scope.',
  },
  {
    id: 'build',
    name: 'Build',
    gist: 'A whole system',
    line: 'A whole system, an internal tool or an agent pipeline, designed, shipped, and handed over with its runbook.',
  },
  {
    id: 'embed',
    name: 'Embed',
    gist: 'Inside your team',
    line: 'Forward-deployed. I join your team, take one problem, and own it from the first conversation to production.',
  },
];

const steps = [
  { name: 'Conversation', line: 'The problem, what it costs, and what done looks like.' },
  { name: 'Written scope', line: 'What gets built, what does not, and how we will know it works.' },
  { name: 'Build in the open', line: 'Working software every week, in your repository.' },
  { name: 'Handover', line: 'Documentation, a runbook, and nothing only I understand.' },
];

const ranked = sortProjects(await getCollection('projects')).filter((project) => project.data.featureRank !== undefined);
const isLive = (project: CollectionEntry<'projects'>) => project.data.links.some((link) => link.kind === 'live');
// A live product is the strongest proof, so it leads and gets a frame of its own;
// the rest keep their feature rank and share the next frame.
const [lead, ...others] = [...ranked.filter(isLive), ...ranked.filter((project) => !isLive(project))];

const frameTitles = [
  'Offer',
  'Shapes',
  ...(lead ? [lead.data.title] : []),
  ...(others.length > 0 ? ['Systems'] : []),
  'Engagement',
  'Contact',
];
const pad = (value: number) => String(value).padStart(2, '0');
const sign = (title: string) => `${pad(frameTitles.indexOf(title) + 1)} / ${pad(frameTitles.length)}`;
---

<BaseLayout
  practice
  title="AI automation and forward-deployed engineering"
  description="Dustin Aceveda automates the work that drains a team, builds the systems behind it, and embeds inside the team as a forward-deployed engineer."
>
  <section class="exhibition-shell practice" aria-label="Nodens practice">
    <p class="visually-hidden" id="frameStatus" aria-live="polite" aria-atomic="true">Frame 1 of {frameTitles.length}: Offer</p>

    <main class="exhibition-stage" id="main">
      <section class="exhibition-frame practice-frame--offer is-active" data-title="Offer" data-route="The offer" data-tone="light" aria-hidden="false">
        <div class="frame-inner practice-offer">
          <p class="frame-sign"><span>{sign('Offer')}</span>Offer</p>
          <h1 class="display practice-title">
            <span>Engineering</span>
            <span>that stays</span>
            <span>until it <em>runs.</em></span>
          </h1>
          <div class="practice-pitch">
            <p class="practice-lede">
              I’m Dustin Aceveda. I automate the work that drains a team, build the systems behind it, and embed inside the team when the problem needs an owner.
            </p>
            <div class="practice-actions">
              <a class="practice-action" href={conversationHref}>Start a conversation <span aria-hidden="true">→</span></a>
              <button class="frame-link" type="button" data-goto="evidence">See the work <span aria-hidden="true">→</span></button>
            </div>
          </div>
          <ol class="practice-ladder" aria-label="Three shapes of work">
            {shapes.map((shape) => <li><strong>{shape.name}</strong><small>{shape.gist}</small></li>)}
          </ol>
        </div>
      </section>

      <section class="exhibition-frame practice-frame--shapes" data-title="Shapes" data-route="Three shapes of work" data-tone="light" aria-hidden="true" inert>
        <div class="frame-inner practice-shapes">
          <p class="frame-sign"><span>{sign('Shapes')}</span>Shapes</p>
          <h2 class="display practice-heading">Three shapes <em>of work.</em></h2>
          <div class="practice-shape-list">
            {shapes.map((shape) => (
              <article class="practice-shape" id={shape.id}>
                <h3>{shape.name}</h3>
                <p>{shape.line}</p>
                <svg viewBox="0 0 160 100" aria-hidden="true">
                  {shape.id === 'automate' && (
                    <>
                      <path d="M20 50H140" />
                      <circle cx="20" cy="50" r="5" /><circle cx="140" cy="50" r="5" />
                      <circle class="core" cx="80" cy="50" r="7" />
                    </>
                  )}
                  {shape.id === 'build' && (
                    <>
                      <path d="M20 72 58 24 82 58 122 28 142 76M20 72 82 58 142 76" />
                      <circle cx="20" cy="72" r="5" /><circle cx="58" cy="24" r="5" />
                      <circle cx="122" cy="28" r="5" /><circle cx="142" cy="76" r="5" />
                      <circle class="core" cx="82" cy="58" r="7" />
                    </>
                  )}
                  {shape.id === 'embed' && (
                    <>
                      <circle class="boundary" cx="88" cy="50" r="44" />
                      <path d="M62 66 88 50 110 28M88 50 114 66" />
                      <circle cx="62" cy="66" r="5" /><circle cx="110" cy="28" r="5" /><circle cx="114" cy="66" r="5" />
                      <circle class="core" cx="88" cy="50" r="7" />
                    </>
                  )}
                </svg>
              </article>
            ))}
          </div>
        </div>
      </section>

      {lead && (
        <section
          class="exhibition-frame practice-frame--case"
          id="evidence"
          data-title={lead.data.title}
          data-route={lead.data.stageLabel}
          data-tone="dark"
          aria-hidden="true"
          inert
        >
          <div class="frame-inner practice-case">
            <p class="frame-sign"><span>{sign(lead.data.title)}</span>Evidence</p>
            <div class="practice-case-name">
              <div>
                <h2 class="display practice-case-title">{lead.data.title}</h2>
                <p class="practice-case-stage">{lead.data.stageLabel}</p>
                <p class="practice-case-subtitle">{lead.data.subtitle}</p>
              </div>
              {lead.data.stack.length > 0 && (
                <ul class="practice-case-stack" aria-label="Built with">
                  {lead.data.stack.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </div>
            <div class="practice-case-record">
              <dl>
                {lead.data.problem && <div><dt>Problem</dt><dd>{lead.data.problem}</dd></div>}
                <div><dt>Built</dt><dd>{lead.data.summary}</dd></div>
                {lead.data.caveat && <div><dt>Note</dt><dd>{lead.data.caveat}</dd></div>}
              </dl>
              <p class="practice-case-links">
                {lead.data.links.map((link) => (
                  <a class="frame-link" href={link.href}>
                    <span class="visually-hidden">{lead.data.title} </span>{link.kind} <span aria-hidden="true">↗</span><span class="visually-hidden"> (external link)</span>
                  </a>
                ))}
                {others.length === 0 && <a class="frame-link" href="/engineering/">All work <span aria-hidden="true">→</span></a>}
              </p>
            </div>
          </div>
        </section>
      )}

      {others.length > 0 && (
        <section class="exhibition-frame practice-frame--case" data-title="Systems" data-route="Also built" data-tone="dark" aria-hidden="true" inert>
          <div class="frame-inner practice-systems">
            <p class="frame-sign"><span>{sign('Systems')}</span>Evidence</p>
            <h2 class="display practice-heading">Also <em>built.</em></h2>
            <div class="practice-system-list">
              {others.map((project) => (
                <article class="practice-system">
                  <div class="practice-system-name">
                    <h3>{project.data.title}</h3>
                    <p class="practice-case-stage">{project.data.stageLabel}</p>
                  </div>
                  <div class="practice-system-record">
                    {project.data.problem && <p class="practice-system-problem">{project.data.problem}</p>}
                    <p>{project.data.summary}</p>
                  </div>
                  <p class="practice-system-links">
                    {project.data.links.map((link) => (
                      <a class="frame-link" href={link.href}>
                        <span class="visually-hidden">{project.data.title} </span>{link.kind} <span aria-hidden="true">↗</span><span class="visually-hidden"> (external link)</span>
                      </a>
                    ))}
                  </p>
                </article>
              ))}
            </div>
            <a class="frame-link practice-systems-more" href="/engineering/">All work <span aria-hidden="true">→</span></a>
          </div>
        </section>
      )}

      <section class="exhibition-frame practice-frame--engagement" data-title="Engagement" data-route="How it runs" data-tone="light" aria-hidden="true" inert>
        <div class="frame-inner practice-engagement">
          <p class="frame-sign"><span>{sign('Engagement')}</span>Engagement</p>
          <h2 class="display practice-heading">How an engagement <em>runs.</em></h2>
          <ol class="practice-steps">
            {steps.map((step) => (
              <li>
                <h3>{step.name}</h3>
                <p>{step.line}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="exhibition-frame practice-frame--contact" data-title="Contact" data-route="Start a conversation" data-tone="dark" aria-hidden="true" inert>
        <div class="frame-inner practice-contact">
          <p class="frame-sign"><span>{sign('Contact')}</span>Contact</p>
          <h2 class="display practice-contact-title">What needs <em>to run?</em></h2>
          <div class="practice-actions">
            <a class="practice-action" href={conversationHref}>Start a conversation <span aria-hidden="true">→</span></a>
            <a class="frame-link practice-email" href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </div>
          <div class="practice-contact-who">
            <p>I am Dustin Aceveda, an AI/software engineer, systems builder, and writer interested in knowledge architecture, automation, infrastructure, and the small practices through which attention becomes visible.</p>
            <nav class="practice-contact-links" aria-label="More about the person">
              <a class="frame-link" href="/about/">About <span aria-hidden="true">→</span></a>
              <a class="frame-link" href="/exhibition/">Enter the exhibition <span aria-hidden="true">→</span></a>
            </nav>
          </div>
        </div>
      </section>
    </main>

    <nav class="exhibition-nav" aria-label="Frame navigation">
      <button id="previousFrame" type="button" aria-label="Previous frame">←</button>
      <div class="exhibition-counter" aria-hidden="true"><span id="frameNumber">01</span><i></i><span id="frameTotal">{pad(frameTitles.length)}</span></div>
      <button id="nextFrame" type="button" aria-label="Next frame">→</button>
    </nav>

    <dialog class="index-panel" id="exhibitionIndex" aria-labelledby="indexTitle">
      <button class="index-close" id="indexClose" type="button">Close index <span aria-hidden="true">×</span></button>
      <div class="index-panel-intro">
        <p class="frame-sign"><span>Directory</span>{frameTitles.length} frames</p>
        <h2 id="indexTitle">Practice index</h2>
        <p>Follow the sequence or go straight to a frame. The rest of the site is one link away.</p>
        <a class="frame-link" href="/index/">Open full site index <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="index-list" id="frameIndex"></ol>
    </dialog>
  </section>
</BaseLayout>

<script src="../scripts/exhibition.ts"></script>
