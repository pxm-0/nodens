---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { canonicalUrl, defaultDescription, siteName, socialImageUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  exhibition?: boolean;
  type?: 'website' | 'article';
  robots?: 'index,follow' | 'noindex,follow';
  publishedAt?: Date;
  updatedAt?: Date;
}

const {
  title = siteName,
  description = defaultDescription,
  exhibition = false,
  type = 'website',
  robots = 'index,follow',
  publishedAt,
  updatedAt,
} = Astro.props;
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = canonicalUrl(Astro.url.pathname);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: canonicalUrl('/'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Dustin Aceveda',
    url: canonicalUrl('/about/'),
    sameAs: ['https://github.com/pxm-0'],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ece7dc" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'is-exhibition': exhibition }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader exhibition={exhibition} />
    <slot />
    <slot name="footer" />
  </body>
</html>
