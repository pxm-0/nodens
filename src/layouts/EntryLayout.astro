---
import BaseLayout from './BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate, projectHref } from '../lib/content';

interface Props {
  title: string;
  description: string;
  section: string;
  kind: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  relatedProjects?: CollectionEntry<'projects'>[];
}
const { title, description, section, kind, publishedAt, updatedAt, tags = [], relatedProjects = [] } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
>
  <main class="article-shell" id="main">
    <article class="article">
      <header class="article-header">
        <div class="article-meta">
          <a href={`/${section}/`}>{section}</a>
          <span>{kind}</span>
          <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
          {tags.map((tag) => <span>{tag}</span>)}
        </div>
        <h1>{title}</h1>
        <p class="dek">{description}</p>
      </header>
      <div class="prose"><slot /></div>
      {relatedProjects.length > 0 && (
        <aside class="related-links" aria-label="Related projects">
          <p class="eyebrow">Related {relatedProjects.length === 1 ? 'project' : 'projects'}</p>
          <ul class="formal-list">
            {relatedProjects.map((project) => <li><a href={projectHref(project)}>{project.data.title}</a></li>)}
          </ul>
        </aside>
      )}
      <a class="text-link" href={`/${section}/`}>Return to {section} →</a>
    </article>
  </main>
  <SiteFooter slot="footer" />
</BaseLayout>
